{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    // DOM entra por causa da suíte e2e: o código dentro de page.evaluate/addInitScript
    // roda no navegador e usa document/localStorage. O backend não depende disso.
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // O projeto roda com tsx e nunca emite JS: o tsc serve só para checagem de
    // tipos. Por isso a suíte pode importar caminhos com extensão .ts.
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
