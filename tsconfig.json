{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // O projeto roda com tsx e nunca emite JS: o tsc serve só para checagem de
    // tipos. Por isso a suíte pode importar caminhos com extensão .ts.
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
