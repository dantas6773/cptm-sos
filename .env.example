# Obrigatório. Assina os tokens de sessão; sem ele o servidor não sobe.
# Gere um valor aleatório com pelo menos 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_longo

# Opcional. Porta do servidor (padrão: 5001).
# PORT=5001

# Opcional. Limite de cálculos de trajeto por minuto (padrão: 60).
# RATE_LIMIT_ROTA=60

# Opcional. Origens permitidas no CORS, separadas por vírgula.
# Padrão: localhost/127.0.0.1 nas portas 5001 e 5500.
# CORS_ORIGINS=https://seu-dominio.com

# Opcional, e só em deploy atrás de proxy reverso (Render, Railway, Nginx...).
# Sem isto, o rate limit trata todos os usuários como um único IP — uma pessoa
# errando a senha travaria o login de todos. Com proxy, use o número de saltos.
# TRUST_PROXY=1

# Opcional, só para desenvolvimento e testes. Com LOGIN_DEMO=1 a tela de login
# ganha um botão que entra com a conta de demonstração em um clique, evitando
# digitar e-mail e senha a cada teste.
# A autenticação continua valendo: nenhuma rota deixa de exigir token, e as
# proteções de identidade (alerta, denúncia, localização) seguem intactas.
# Nunca ligue isto em um ambiente publicado.
# LOGIN_DEMO=1
